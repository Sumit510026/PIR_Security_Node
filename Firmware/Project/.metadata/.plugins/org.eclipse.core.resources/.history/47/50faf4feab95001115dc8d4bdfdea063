#include"stm32f1xx.h"
#include"LED.h"

void LED_Init(void)
{
	RCC->APB2ENR |=  (1U << 4);
	GPIOC->CRH   &= ~(0xFU << 20);
	GPIOC->CRH   |=  (2U << 20);
}

void LED_Off(void)
{
	GPIOC->ODR 	|= (1U << 13);
}

void LED_On(void)
{
	GPIOC->ODR &= ~(1U << 13);
}

void LED_Toggle(void)
{
	 GPIOC->ODR ^= (1U << 13);
}
