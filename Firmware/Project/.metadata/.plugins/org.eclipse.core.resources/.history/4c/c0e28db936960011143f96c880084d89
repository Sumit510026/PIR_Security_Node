#include"Button.h"

void Button_Init(void)
{
	RCC->APB2ENR |= (1U << 2);
	GPIOA->CRL  &= ~(0xF << 4);
	GPIOA->CRL  |=  (0x8U << 4);
}


void SetAmrned(void)
{

	if (GPIOA->IDR & (1U << 2))
	{
		SYSTEM_ARMED
	}
	else
	{
		SYSTEM_DISARMED
	}
}
